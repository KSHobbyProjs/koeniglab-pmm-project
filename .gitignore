# ignore all temporary python files (pycache, pyc, ipynb_checkpoints)
__pycache__/
*.pyc
.ipynb_checkpoints/

# ignore the local python environment
.venv/

# ignore all large data files (.pkl), all normalization files (.json)
*.pkl
*.json

# ignore all large PMM result and EC result folders
results/*
data/ec_data/*

# except the .gitkeep file in results so that the directory itself isn't deleted, similarly for 
!results/.gitkeep
!data/ec_data/.gitkeep
!data/sample_data/.gitkeep
